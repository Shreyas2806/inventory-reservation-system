# ─── Database ────────────────────────────────────────────────────────────────
# Pooled connection (PgBouncer) — used by Prisma Client at runtime
# Supabase: use port 6543 (Transaction mode pooler)
DATABASE_URL="postgresql://postgres:password@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection — used by Prisma Migrate (prisma migrate deploy)
# Supabase: use port 5432 (direct, bypasses PgBouncer)
DIRECT_URL="postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres"


# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Cron Protection ─────────────────────────────────────────────────────────
# Set a strong random secret to protect the /api/cron/cleanup route in production
CRON_SECRET="your-random-secret-here"
