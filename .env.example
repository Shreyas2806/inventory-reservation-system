# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Supabase / Neon / local)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/inventory_reservation"

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Cron Protection ─────────────────────────────────────────────────────────
# Set a strong random secret to protect the /api/cron/cleanup route in production
CRON_SECRET="your-random-secret-here"
